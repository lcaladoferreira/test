  "actions": [
    {
      "id": "get-youtube-transcript",
      "name": "Get YouTube Transcript",
      "description": "Extract transcript, captions and subtitles from any YouTube video URL with timestamps, language selection, manual/auto caption preference, optional translation and JSON/text/SRT output. For RAG ingestion, LLM context, research, summarization and knowledge-base indexing. Costs $0.004 USDC on Base via x402. No signup required.",
      "method": "POST",
      "endpoint": "https://x402.bankr.bot/0xe100c45ad23fa81aeca03ce61871e2ea3cf8e9eb/youtube-transcript",
      "parameters": {
        "required": ["url"],
        "optional": ["videoId", "language", "sourcePreference", "translateTo", "includeSegments", "format"]
      },
      "schema": {
        "input": {
          "type": "object",
          "properties": {
            "url": {"type": "string", "description": "YouTube video URL"},
            "videoId": {"type": "string", "description": "11-char YouTube video ID"},
            "language": {"type": "string", "description": "Language code"},
            "sourcePreference": {"type": "string", "enum": ["any", "manual", "generated"]},
            "translateTo": {"type": "string", "description": "Translation target language code"},
            "includeSegments": {"type": "boolean"},
            "format": {"type": "string", "enum": ["json", "text", "srt"]}
          }
        }
      }
    },
